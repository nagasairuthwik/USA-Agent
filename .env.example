# ==============================================================================
# Agentic AI Travel Intelligence Platform - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS
# DO NOT COMMIT REAL API KEYS TO VERSION CONTROL
# ==============================================================================

# 1. Groq Cloud API Key & Model Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# 2. Tavily AI Search API Key (Live Transit Routing, Hotel Extraction & Safety)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# 3. OpenRouteService (ORS) / Google Maps Keys
ORS_API_KEY=your_ors_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# 4. OpenStreetMap Nominatim - Geocoding Configuration
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=USAAgentTravelIntelligence/1.0

# 5. OSRM - Public Road Routing Server
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_PROFILE=driving

# 6. Public Transit & Agency Feeds Configuration (MTA, NJ Transit, WMATA, SEPTA, MBTA, CTA, Metra, DART, Miami-Dade, BART, Caltrain, VTA)
TRANSIT_DATA_SOURCE=TAVILY_GTFS_REGIONAL_FEEDS
US_METRO_SYSTEMS_REFERENCE_URL=https://www.youtube.com/watch?v=AgOxFvHamP4

# 7. Connected Hotel & Booking Sources (Wyndham Hotels, HotelsNearTheMetro, Booking.com, Expedia)
WYNDHAM_DIRECTORY_URL=https://www.wyndhamhotels.com/
HOTELS_NEAR_THE_METRO_URL=https://hotelsnearthemetro.com/hotels-near-the-metro-in-new_york
BOOKING_DEMAND_API_SOURCE=ACTIVE
EXPEDIA_RAPID_API_SOURCE=ACTIVE

# 8. FBI & Open Crime Datasets Configuration
CRIME_DATA_SOURCE=FBI_UCR_AND_OPEN_CRIME_TAVILY

# 9. Default Engine Pipeline Thresholds
DEFAULT_CURRENCY=USD
DEFAULT_BUDGET_MIN=50.0
DEFAULT_BUDGET_MAX=60.0
DEFAULT_MAX_COMMUTE_MINUTES=90
